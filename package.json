{
  "name": "octopus-sports-academy",
  "version": "1.0.0",
  "description": "Octopus Sports Academy - condo-based swimming class booking, QR attendance and coach ratings",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node db/migrate.js",
    "seed": "node db/seed.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:stop": "pm2 stop octopus",
    "pm2:delete": "pm2 delete octopus",
    "pm2:logs": "pm2 logs octopus",
    "pm2:status": "pm2 status"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pm2": "^7.1.2",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  }
}
